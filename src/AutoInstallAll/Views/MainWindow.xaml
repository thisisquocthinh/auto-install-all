<Window x:Class="AutoInstallAll.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AutoInstallAll.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Thiết lập máy tính mới — Auto Install All"
        Width="1480" Height="940" MinWidth="1280" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CreamBrush}"
        FontFamily="{StaticResource TextFont}" FontSize="13"
        Foreground="{DynamicResource InkBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- ===================== Thẻ phần mềm (1 thẻ = 1 phần mềm) ===================== -->
        <DataTemplate x:Key="AppCardTemplate" DataType="{x:Type vm:AppCardViewModel}">
            <CheckBox Style="{StaticResource AppCard}" Background="{Binding Background}" Margin="7"
                      IsChecked="{Binding Item.IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Item.Name}"
                      ToolTip="{Binding Item.StatusMessage}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hàng trên: icon 40x40 (ô tích nằm trong template AppCard) -->
                    <Viewbox Width="40" Height="40" HorizontalAlignment="Left" Stretch="Uniform">
                        <ContentControl Content="{Binding Item}" ContentTemplate="{StaticResource AppIconTemplate}" />
                    </Viewbox>

                    <!-- Hàng giữa: tên + công dụng -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,10">
                        <TextBlock Text="{Binding Item.Name}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                                   TextWrapping="Wrap" MaxHeight="46" TextTrimming="CharacterEllipsis" LineHeight="21" />
                        <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource SubtleBrush}" Margin="0,3,0,0"
                                   TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Hàng đáy: nhãn trạng thái / tiến trình -->
                    <StackPanel Grid.Row="2">
                        <Border Background="{DynamicResource WhiteBrush}" CornerRadius="13" Padding="10,5" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ProgressBar Style="{StaticResource PastelBar}" Height="6" Margin="0,8,0,0"
                                     Background="{DynamicResource TrackBrush}" Foreground="{DynamicResource InkBrush}" Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </CheckBox>
        </DataTemplate>
        <!-- ===================== Dòng ứng dụng (trang Apps) ===================== -->
        <!-- Độ rộng cột dùng chung cho tiêu đề và từng dòng ở trang Apps -->
        <GridLength x:Key="ColCheck">40</GridLength>
        <GridLength x:Key="ColIcon">56</GridLength>
        <GridLength x:Key="ColSilent">0.9*</GridLength>
        <GridLength x:Key="ColVersion">140</GridLength>
        <GridLength x:Key="ColActions">132</GridLength>

        <DataTemplate x:Key="AppRowTemplate">
            <Border Background="{DynamicResource WhiteBrush}" CornerRadius="18" Padding="16,12" Margin="0,0,0,8"
                    ToolTip="{Binding StatusMessage}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColCheck}" />
                        <ColumnDefinition Width="{StaticResource ColIcon}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource ColSilent}" />
                        <ColumnDefinition Width="{StaticResource ColVersion}" />
                        <ColumnDefinition Width="{StaticResource ColActions}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Style="{StaticResource CircleCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              VerticalAlignment="Center" HorizontalAlignment="Left" />

                    <Grid Grid.Column="1" Width="44" Height="44" HorizontalAlignment="Left">
                        <Ellipse Fill="{Binding ColorGroup, Converter={StaticResource ColorGroupToBrush}}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AppIconTemplate}" />
                    </Grid>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse Width="7" Height="7" Fill="{Binding State, Converter={StaticResource StateToBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding State, Converter={StaticResource StateToText}}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding PackagerType, Mode=OneWay}" />
                                <Run Text="·" />
                                <Run Text="{Binding Source.Mode, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <TextBox Grid.Column="3" Style="{StaticResource Field}" Height="36" Padding="10,0" Margin="0,0,16,0"
                             Background="{DynamicResource CreamBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                             ToolTip="Tham số cài ngầm — sửa rồi bấm Lưu thay đổi"
                             Text="{Binding SilentArgs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />

                    <Border Grid.Column="4" Background="{DynamicResource BeigeBrush}" CornerRadius="14" Padding="12,6"
                            HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="140">
                        <TextBlock Text="{Binding VersionLabel}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </Border>

                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" ToolTip="Tải bản mới nhất về .\Installers\" AutomationProperties.Name="Tải"
                                Command="{Binding DataContext.DownloadItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="14" />
                        </Button>
                        <Button Style="{StaticResource IconButtonDark}" ToolTip="Cài đặt tự động" AutomationProperties.Name="Cài đặt"
                                Command="{Binding DataContext.InstallItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButtonDanger}" ToolTip="Xoá khỏi danh sách và USB" AutomationProperties.Name="Xoá"
                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <ProgressBar Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Style="{StaticResource PastelBar}" Height="6" Margin="0,10,0,0"
                                 Background="{DynamicResource BeigeBrush}" Foreground="{DynamicResource InkBrush}" Value="{Binding Progress, Mode=OneWay}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Tiêu đề cột của danh sách Apps -->
        <DataTemplate x:Key="AppHeaderTemplate">
            <Grid Margin="16,0,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColCheck}" />
                    <ColumnDefinition Width="{StaticResource ColIcon}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource ColSilent}" />
                    <ColumnDefinition Width="{StaticResource ColVersion}" />
                    <ColumnDefinition Width="{StaticResource ColActions}" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                </Grid.Resources>
                <TextBlock Grid.Column="2" Text="ỨNG DỤNG" />
                <TextBlock Grid.Column="3" Text="THAM SỐ CÀI NGẦM" />
                <TextBlock Grid.Column="4" Text="PHIÊN BẢN" />
                <TextBlock Grid.Column="5" Text="THAO TÁC" HorizontalAlignment="Right" Margin="0,0,4,0" />
            </Grid>
        </DataTemplate>

        <Style x:Key="PageHeader" TargetType="TextBlock" BasedOn="{StaticResource H1}">
            <Setter Property="FontSize" Value="38" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="88" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="410" />
        </Grid.ColumnDefinitions>

        <!-- =============================================================
             CỘT TRÁI — Sidebar: icon tròn + nhãn tiếng Việt
             ============================================================= -->
        <Border Style="{StaticResource BeigePanel}" Padding="0,20">
            <DockPanel>
                <RadioButton DockPanel.Dock="Bottom" GroupName="Nav" Style="{StaticResource NavItem}" Margin="0" Content="&#xE713;" Tag="Cài đặt"
                             AutomationProperties.Name="Cài đặt"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Settings}" />
                <StackPanel HorizontalAlignment="Center">
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="&#xE80F;" Tag="Trang chủ" AutomationProperties.Name="Trang chủ"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Home}" />
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="&#xE71D;" Tag="Kho cài đặt" AutomationProperties.Name="Kho cài đặt"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Apps}" />
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="&#xEDA2;" Tag="Chia ổ cứng" AutomationProperties.Name="Chia ổ cứng"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Disk}" />
                    <RadioButton GroupName="Nav" Style="{StaticResource NavItem}" Content="&#xE8B7;" Tag="Thư mục USB" AutomationProperties.Name="Thư mục USB"
                                 ToolTip="Mở thư mục .\Installers\ trong Windows Explorer"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Usb, Mode=OneWay}"
                                 Command="{Binding OpenUsbFolderCommand}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- =============================================================
             CỘT GIỮA — Main Area (các trang)
             ============================================================= -->
        <Grid Grid.Column="1" Margin="28,4,16,0">

            <!-- ===================== TRANG CHỦ ===================== -->
            <DockPanel Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Home}">
                <StackPanel DockPanel.Dock="Top" Margin="7,6,0,0">
                    <TextBlock Text="Thiết lập máy tính mới" FontFamily="{StaticResource DisplayFont}" FontSize="35" FontWeight="Bold"
                               Foreground="{DynamicResource InkBrush}" />
                    <TextBlock Text="Chọn phần mềm cần dùng và bấm Bắt đầu để tự động cài đặt từ USB" FontSize="16"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />

                    <!-- Thanh nút thao tác nhanh -->
                    <WrapPanel Margin="0,18,0,4">
                        <Button Style="{StaticResource PillDark}" Margin="0,0,10,10" Command="{Binding ToggleSelectAllCommand}"
                                ToolTip="Chọn / bỏ chọn tất cả phần mềm" Content="{Binding AllAppsLabel}" />
                        <Button Style="{StaticResource PillButton}" Margin="0,0,10,10" Command="{Binding SelectRecommendedCommand}"
                                ToolTip="Tự chọn Google Chrome, UniKey, WinRAR, UltraViewer, Zalo PC">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Bộ cơ bản khuyên dùng" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="0,0,10,10" Command="{Binding CheckLatestVersionsCommand}"
                                ToolTip="Tìm bản mới trên mạng, tải về .\Installers\ và tự xoá bản cũ">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="13" Margin="0,0,8,0" />
                                <TextBlock Text="Kiểm tra bản mới" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="0,0,10,10" Command="{Binding AddAppCommand}" AutomationProperties.Name="Thêm phần mềm">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Thêm phần mềm" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- Lưới 4 cột: mỗi phần mềm một thẻ riêng -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource AppCardTemplate}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ===================== APPS ===================== -->
            <DockPanel Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Apps}" Margin="0,0,16,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Kho cài đặt" Style="{StaticResource PageHeader}" />
                    <TextBlock Style="{StaticResource Body}" Text="Danh sách phần mềm trên USB — có thể sửa tham số cài ngầm rồi bấm Lưu thay đổi." />
                    <WrapPanel Margin="0,16,0,14">
                        <Button Style="{StaticResource PillDark}" Margin="0,0,10,8" Command="{Binding CheckLatestVersionsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Kiểm tra bản mới" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="0,0,10,8" Command="{Binding AddAppCommand}" Content="+ Thêm phần mềm" />
                        <Button Style="{StaticResource PillButton}" Margin="0,0,10,8" Command="{Binding SaveManifestCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Lưu thay đổi" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillButton}" Margin="0,0,10,8" Command="{Binding ToggleSelectAllCommand}" Content="Chọn / bỏ chọn tất cả" />
                    </WrapPanel>
                </StackPanel>
                <ContentControl DockPanel.Dock="Top" ContentTemplate="{StaticResource AppHeaderTemplate}" Margin="0,0,10,0" Focusable="False" />
                <ScrollViewer>
                    <StackPanel Margin="0,0,10,80">
                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRowTemplate}" />
                        <TextBlock Text="Thư viện hệ thống" Style="{StaticResource H3}" Margin="4,16,0,10" />
                        <ItemsControl ItemsSource="{Binding SystemTools}" ItemTemplate="{StaticResource AppRowTemplate}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ===================== DISK & BITLOCKER ===================== -->
            <DockPanel Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Disk}" Margin="0,0,16,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Chia ổ cứng &amp; BitLocker" Style="{StaticResource PageHeader}" />
                    <TextBlock Style="{StaticResource Body}" Text="Tắt mã hoá, chia ổ C/D và dọn ứng dụng cài sẵn trên máy mới. Các thao tác yêu cầu quyền Administrator." />
                </StackPanel>
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,80">
                        <!-- BitLocker -->
                        <Border Style="{StaticResource WhiteCard}" Margin="0,0,0,14" Padding="22">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource PillButton}" Margin="0,0,8,0" Command="{Binding RefreshSystemCommand}" Content="Đọc lại" />
                                        <Button Style="{StaticResource PillDark}" Command="{Binding ToggleBitLockerCommand}"
                                                Visibility="{Binding BitLockerIsOff, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE785;" FontSize="14" Margin="0,0,8,0" />
                                                <TextBlock Text="Tắt BitLocker" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="46" Height="46" CornerRadius="23" Background="{DynamicResource LavenderBrush}" Margin="0,0,14,0">
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding BitLockerGlyph}" FontSize="18" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="BitLocker — Ổ C:" Style="{StaticResource H3}" />
                                            <TextBlock Text="{Binding BitLockerText}" Style="{StaticResource Body}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                                <UniformGrid Columns="4" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Trạng thái" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding BitLocker.Conversion, FallbackValue=—}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Bảo vệ" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding BitLocker.Protection, FallbackValue=—}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Đã mã hoá" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding BitLocker.EncryptionPercentage, StringFormat={}{0:0.#}%, FallbackValue=—}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Thuật toán" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding BitLocker.EncryptionMethod, FallbackValue=—, TargetNullValue=—}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </UniformGrid>
                                <ProgressBar Style="{StaticResource PastelBar}" Margin="0,16,0,0" Foreground="{DynamicResource LavenderBrush}"
                                             Value="{Binding BitLocker.DecryptionProgress, Mode=OneWay, FallbackValue=0}"
                                             Visibility="{Binding IsBitLockerBusy, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <!-- Partitions -->
                        <Border Style="{StaticResource WhiteCard}" Margin="0,0,0,14" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Phân vùng trên ổ hệ thống" Style="{StaticResource H3}" />
                                <TextBlock Text="{Binding DiskSubtitle}" Style="{StaticResource Body}" Margin="0,2,0,12" />
                                <ItemsControl ItemsSource="{Binding Partitions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="56" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding PartitionNumber, StringFormat=#{0}}" Foreground="{DynamicResource MutedBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DriveLetter, StringFormat={}{0}:, TargetNullValue=—}" FontWeight="Bold" />
                                                    <TextBlock Grid.Column="2" Text="{Binding PartitionType}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeGB, StringFormat={}{0} GB}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="4" Text="{Binding UsedGB, StringFormat=đã dùng {0} GB}" Foreground="{DynamicResource MutedBrush}" />
                                                    <TextBlock Grid.Column="5" Foreground="{DynamicResource MutedBrush}">
                                                        <Run Text="{Binding FileSystem, Mode=OneWay}" />
                                                        <Run Text="{Binding Label, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                           Text="Chia ổ: kéo thanh trượt rồi bấm Chia nhanh ổ C / D ở cột bên phải." />
                            </StackPanel>
                        </Border>

                        <!-- Bloatware -->
                        <Border Style="{StaticResource WhiteCard}" Padding="22">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PillDark}" Command="{Binding RemoveBloatwareCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Margin="0,0,8,0" />
                                            <TextBlock Text="Gỡ ứng dụng rác" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel>
                                        <TextBlock Text="Gỡ ứng dụng rác cài sẵn" Style="{StaticResource H3}" />
                                        <TextBlock Text="Gỡ ứng dụng Appx cài sẵn cho mọi người dùng (giữ lại Store, Photos, Calculator, Media Player)." Style="{StaticResource Body}" />
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Bloatware}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Style="{StaticResource AppChip}" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding PackageName}">
                                                <TextBlock FontSize="12.5">
                                                    <Run Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" />
                                                    <Run Text="{Binding Status, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <Border Background="{DynamicResource BeigeBrush}" CornerRadius="16" Padding="12,12,4,4">
                                                <ItemsPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ===================== USB FOLDER ===================== -->
            <DockPanel Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Usb}" Margin="0,0,16,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Thư mục USB" Style="{StaticResource PageHeader}" />
                    <TextBlock Style="{StaticResource Body}" Text="{Binding RootPath}" />
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="230" />
                    </Grid.RowDefinitions>

                    <UniformGrid Columns="4" Margin="0,0,-12,14">
                        <Button Style="{StaticResource PillWhite}" Margin="0,0,12,0" Command="{Binding OpenFolderCommand}" CommandParameter="root" HorizontalContentAlignment="Left" Padding="18,14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="20" HorizontalAlignment="Left" />
                                <TextBlock Text="Thư mục gốc" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="AutoInstallAll.exe" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillWhite}" Margin="0,0,12,0" Command="{Binding OpenFolderCommand}" CommandParameter="installers" HorizontalContentAlignment="Left" Padding="18,14" Background="{DynamicResource MintBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" FontSize="20" HorizontalAlignment="Left" />
                                <TextBlock Text=".\Installers\" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding UsbSummary}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillWhite}" Margin="0,0,12,0" Command="{Binding OpenFolderCommand}" CommandParameter="icons" HorizontalContentAlignment="Left" Padding="18,14" Background="{DynamicResource PeachBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEB9F;" FontSize="20" HorizontalAlignment="Left" />
                                <TextBlock Text=".\Icons\" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="Icon trích xuất" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PillWhite}" Margin="0,0,12,0" Command="{Binding OpenFolderCommand}" CommandParameter="logs" HorizontalContentAlignment="Left" Padding="18,14" Background="{DynamicResource LavenderBrush}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9F9;" FontSize="20" HorizontalAlignment="Left" />
                                <TextBlock Text=".\Logs\" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <TextBlock Text="Nhật ký cài đặt" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Border Grid.Row="1" Style="{StaticResource WhiteCard}" Padding="20,16" Margin="0,0,0,14">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" Padding="14,7" Command="{Binding RescanUsbCommand}" Content="Quét lại &amp; dọn .downloading" />
                                <StackPanel>
                                    <TextBlock Text="Bộ cài trong .\Installers\" Style="{StaticResource H3}" />
                                    <TextBlock Text="{Binding UsbSizeText}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding InstallerFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="200" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Owner}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Modified}" Foreground="{DynamicResource MutedBrush}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource WhiteCard}" Padding="20,14" Margin="0,0,0,70">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Command="{Binding ClearLogCommand}" Content="Xoá màn hình" />
                                <TextBlock Text="Nhật ký hoạt động" Style="{StaticResource H3}" />
                            </DockPanel>
                            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" BorderThickness="0" Background="Transparent"
                                     FontFamily="Consolas" FontSize="11.5" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>

            <!-- ===================== SETTINGS ===================== -->
            <DockPanel Visibility="{Binding CurrentPage, Converter={StaticResource EnumToVisibility}, ConverterParameter=Settings}" Margin="0,0,16,0">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="Cài đặt" Style="{StaticResource PageHeader}" />
                    <TextBlock Style="{StaticResource Body}" Text="Lưu trong manifest.json trên USB — áp dụng cho mọi máy dùng chung USB này." />
                </StackPanel>
                <ScrollViewer>
                    <StackPanel Margin="0,0,0,80" MaxWidth="760" HorizontalAlignment="Left">
                        <!-- Giao diện -->
                        <Border Style="{StaticResource WhiteCard}" Padding="24" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Giao diện" Style="{StaticResource H3}" />
                                <TextBlock Text="Chế độ tối giúp dịu mắt khi làm việc lâu hoặc trong phòng thiếu sáng. Đổi ngay, không cần khởi động lại."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" AutomationProperties.Name="Giao diện sáng"
                                                 IsChecked="{Binding ThemeMode, Converter={StaticResource EnumToBool}, ConverterParameter=Light}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="13" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            <TextBlock Text="Sáng" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" AutomationProperties.Name="Giao diện tối"
                                                 IsChecked="{Binding ThemeMode, Converter={StaticResource EnumToBool}, ConverterParameter=Dark}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" FontSize="13" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            <TextBlock Text="Tối (dịu mắt)" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource SegmentButton}" GroupName="Theme" AutomationProperties.Name="Giao diện theo Windows"
                                                 IsChecked="{Binding ThemeMode, Converter={StaticResource EnumToBool}, ConverterParameter=System}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="13" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                            <TextBlock Text="Theo Windows" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Cập nhật ứng dụng -->
                        <Border Style="{StaticResource WhiteCard}" Padding="24" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Cập nhật Auto Install All" Style="{StaticResource H3}" />
                                <TextBlock Text="{Binding AppVersionText}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding AppUpdateStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,12" />
                                <WrapPanel>
                                    <Button Style="{StaticResource PillDark}" Margin="0,0,10,0" Command="{Binding CheckAppUpdateCommand}" AutomationProperties.Name="Kiểm tra cập nhật">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="13" Margin="0,0,8,0" />
                                            <TextBlock Text="Kiểm tra cập nhật" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource PillButton}" Background="{DynamicResource MintBrush}" Margin="0,0,10,0"
                                            Command="{Binding InstallAppUpdateCommand}" Content="Tải &amp; cập nhật ngay"
                                            Visibility="{Binding HasAppUpdate, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Style="{StaticResource PillButton}" Command="{Binding OpenReleasesPageCommand}" Content="Xem trên GitHub" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource WhiteCard}" Padding="24" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Cài đặt &amp; Tải bộ cài" Style="{StaticResource H3}" />
                                <TextBlock Text="Timeout mỗi ứng dụng (phút)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource Field}" Width="160" HorizontalAlignment="Left" Text="{Binding SettingTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Style="{StaticResource AppChip}" Margin="0,16,0,0" Background="{DynamicResource BeigeBrush}" IsChecked="{Binding SettingVerifySha256}"
                                          Content="Bắt buộc khớp SHA-256 khi tải bản mới" HorizontalAlignment="Left" />
                                <CheckBox Style="{StaticResource AppChip}" Margin="0,10,0,0" IsChecked="{Binding SettingDeleteOldInstaller}"
                                          Content="Tự xoá bộ cài cũ sau khi tải bản mới thành công" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource WhiteCard}" Padding="24" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Chia nhanh ổ C / D" Style="{StaticResource H3}" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Dung lượng trống tối thiểu còn lại trên C: (GB)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Field}" Text="{Binding SettingMinFreeGB, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Dung lượng ổ dữ liệu mặc định (GB)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Field}" Text="{Binding SettingDataSizeGB, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Ký tự ổ dữ liệu" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Field}" MaxLength="1" Text="{Binding SettingDataLetter, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Nhãn ổ dữ liệu" Style="{StaticResource FieldLabel}" />
                                        <TextBox Style="{StaticResource Field}" MaxLength="32" Text="{Binding SettingDataLabel, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource PillDark}" HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Lưu cài đặt" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,24,0,0">
                            <Run Text="Auto Install All · " />
                            <Run Text="{Binding ModeText, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding RootPath, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- ===================== Thanh tác vụ nổi (mọi trang) ===================== -->
            <Border VerticalAlignment="Bottom" Margin="0,0,16,8" CornerRadius="22" Background="{DynamicResource InkBrush}" Padding="20,12"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PillSmall}" Command="{Binding CancelOperationCommand}" Content="Huỷ" Margin="12,0,0,0" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding BusyMessage}" Foreground="{DynamicResource WhiteBrush}" FontWeight="SemiBold" Width="320"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <ProgressBar Style="{StaticResource PastelBar}" Height="8" Background="{DynamicResource InkTrackBrush}" Foreground="{DynamicResource MintBrush}"
                                 Value="{Binding BusyProgress, Mode=OneWay}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- =============================================================
             CỘT PHẢI — 3 khối: USB & BitLocker / Ổ cứng / Nút Bắt đầu
             ============================================================= -->
        <Border Grid.Column="2" Style="{StaticResource BeigePanel}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Khối 1: Bộ nhớ USB & BitLocker -->
                <StackPanel>
                    <DockPanel>
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource WhiteBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE88E;" FontSize="20" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bộ nhớ USB (.\Installers\)" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="{Binding UsbSummary}" FontSize="13" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       ToolTip="{Binding UsbSizeText}" />
                        </StackPanel>
                    </DockPanel>

                    <Button Style="{StaticResource PillWhite}" Margin="0,14,0,0" Padding="14,10" HorizontalContentAlignment="Stretch"
                            Command="{Binding ToggleBitLockerCommand}" ToolTip="Bấm để đọc lại trạng thái hoặc tắt BitLocker trên ổ C:">
                        <StackPanel>
                            <TextBlock Text="{Binding BitLockerText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BitLockerIsOff}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Style="{StaticResource PastelBar}" Height="6" Margin="0,8,0,0" Foreground="{DynamicResource LavenderBrush}"
                                         Value="{Binding BitLocker.DecryptionProgress, Mode=OneWay, FallbackValue=0}"
                                         Visibility="{Binding IsBitLockerBusy, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Button>

                    <!-- Chuẩn hóa Desktop & Menu -->
                    <Button Style="{StaticResource PillButton}" Background="{DynamicResource MintBrush}" Margin="0,10,0,0" Padding="14,10"
                            HorizontalContentAlignment="Left" Command="{Binding ApplyDesktopTweaksCommand}"
                            AutomationProperties.Name="Chuẩn hóa Desktop và Menu"
                            ToolTip="Hiện icon This PC, Thư mục người dùng, Network, Control Panel ra Desktop; bật menu chuột phải đầy đủ (Windows 11); hiện đuôi file">
                        <TextBlock Text="✨ Chuẩn hóa Desktop &amp; Menu" FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- Khối 2: Chia phân vùng ổ cứng & Thư viện (giãn đầy hàng giữa) -->
                <Border Grid.Row="1" Style="{StaticResource WhiteCard}" Margin="0,14,0,14" Padding="20,18">
                    <DockPanel>
                        <UniformGrid DockPanel.Dock="Bottom" Columns="2">
                            <Button Style="{StaticResource PillButton}" Background="{DynamicResource LavenderBrush}" Margin="0,0,6,0" Padding="10,12"
                                    HorizontalContentAlignment="Center" Command="{Binding InstallVcRedistCommand}"
                                    ToolTip="{Binding VcRedist.VersionLabel, FallbackValue=Visual C++ Redistributable}" Content="Cài Visual C++" />
                            <Button Style="{StaticResource PillButton}" Background="{DynamicResource PeachBrush}" Margin="6,0,0,0" Padding="10,12"
                                    HorizontalContentAlignment="Center" Command="{Binding InstallDirectXCommand}"
                                    ToolTip="{Binding DirectX.VersionLabel, FallbackValue=DirectX}" Content="Cài DirectX" />
                        </UniformGrid>

                        <StackPanel>
                            <TextBlock Text="Chia phân vùng ổ cứng &amp; Thư viện" FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DiskSubtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />

                            <DockPanel Margin="0,12,0,12">
                                <Button DockPanel.Dock="Right" Style="{StaticResource PillDark}" VerticalAlignment="Center" Padding="16,9"
                                        Command="{Binding QuickSplitCommand}" Content="Chia nhanh ổ C / D"
                                        ToolTip="Thu nhỏ ổ C: và tạo ổ dữ liệu mới, giữ nguyên dữ liệu" />
                                <TextBlock Text="{Binding DiskTotalText}" FontFamily="{StaticResource DisplayFont}" FontSize="36" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>

                            <!-- Kéo sang phải để ổ C lớn hơn, sang trái để ổ D lớn hơn -->
                            <Slider Minimum="0" Maximum="{Binding SplitMaxGB}" Value="{Binding SplitSizeGB, Mode=TwoWay}" IsDirectionReversed="True"
                                    SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                    AutomationProperties.Name="Dung lượng ổ dữ liệu" />
                            <DockPanel Margin="0,6,0,0">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding DataSizeText}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SystemSizeText}" FontSize="13" FontWeight="SemiBold" />
                            </DockPanel>
                            <!-- Sơ đồ phân vùng trực quan -->
                            <ItemsControl ItemsSource="{Binding DiskBars}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <ProgressBar Style="{StaticResource PastelBar}" Height="30" Tag="10" Background="{DynamicResource CreamBrush}"
                                                         Foreground="{Binding Fill}" Value="{Binding Percent, Mode=OneWay}" />
                                            <DockPanel Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" />
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding SplitPlanText}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource DangerBrush}"
                                       Visibility="{Binding IsSplitPlanValid, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Khối 3: Nút hành động chính kiêm thanh tiến trình -->
                <StackPanel Grid.Row="2">
                <CheckBox IsChecked="{Binding ApplyTweaksWithSetup}" Margin="4,0,0,10" Cursor="Hand" VerticalContentAlignment="Center"
                          Content="Chuẩn hóa Desktop &amp; Menu sau khi cài xong" FontSize="13" Foreground="{DynamicResource InkBrush}" />
                <Button Command="{Binding StartAutoSetupCommand}" AutomationProperties.Name="Bắt đầu cài đặt ngay" Cursor="Hand"
                        ToolTip="Cài đặt tự động các phần mềm đã chọn (bấm lần nữa khi đang chạy để huỷ)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="20" Background="{DynamicResource CoralBrush}" MinHeight="104">
                                <Grid>
                                    <ProgressBar Style="{StaticResource PastelBar}" Height="Auto" Tag="20" Background="Transparent"
                                                 Foreground="{DynamicResource CoralStrongBrush}" Value="{Binding QueuePercent, Mode=OneWay}" />
                                    <DockPanel Margin="20,16">
                                        <Border DockPanel.Dock="Right" Width="46" Height="46" CornerRadius="23" Background="{DynamicResource InkBrush}"
                                                VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="&#xE768;" Foreground="{DynamicResource WhiteBrush}" FontSize="16" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="Title" Text="{Binding StartTitle}" FontSize="17" FontWeight="Black"
                                                       Foreground="{DynamicResource OnCoralBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding QueueStatus}" FontSize="13" Foreground="{DynamicResource OnCoralSubtleBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.92" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsQueueRunning}" Value="True">
                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE71A;" />
                                    <Setter TargetName="Title" Property="Text" Value="{Binding QueueTitle}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsQueueRunning}" Value="False" />
                                        <Condition Binding="{Binding QueueTitle, Converter={StaticResource NullToVisibility}}" Value="Visible" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="Title" Property="Text" Value="{Binding QueueTitle}" />
                                </MultiDataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
