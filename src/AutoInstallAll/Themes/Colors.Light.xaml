<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Bảng màu Sáng (Warm Pastel) — cùng tên khoá ở cả hai file; mọi chỗ dùng phải là DynamicResource -->
    <SolidColorBrush x:Key="CreamBrush" Color="#FAF7F5" />  <!-- Nền cửa sổ -->
    <SolidColorBrush x:Key="BeigeBrush" Color="#EFEAE4" />  <!-- Sidebar / cột phải / nút be -->
    <SolidColorBrush x:Key="BeigeDeepBrush" Color="#E2DBD2" />  <!-- Viền be đậm -->
    <SolidColorBrush x:Key="LineBrush" Color="#E3DCD3" />  <!-- Đường kẻ -->
    <SolidColorBrush x:Key="InkBrush" Color="#111111" />  <!-- Chữ chính / nút đen -->
    <SolidColorBrush x:Key="MutedBrush" Color="#4B5563" />  <!-- Chữ phụ -->
    <SolidColorBrush x:Key="SubtleBrush" Color="#374151" />  <!-- Chữ mô tả trên thẻ -->
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />  <!-- Bề mặt thẻ trắng / chữ trên nền Ink -->
    <SolidColorBrush x:Key="PinkBrush" Color="#F4C5C7" />
    <SolidColorBrush x:Key="PeachBrush" Color="#FCE0C1" />
    <SolidColorBrush x:Key="LavenderBrush" Color="#D4D4FA" />
    <SolidColorBrush x:Key="MintBrush" Color="#C3F0DC" />
    <SolidColorBrush x:Key="PinkSoftBrush" Color="#FBE3E4" />
    <SolidColorBrush x:Key="PinkStrongBrush" Color="#EE8C95" />
    <SolidColorBrush x:Key="CoralBrush" Color="#F28B72" />  <!-- Nút BẮT ĐẦU -->
    <SolidColorBrush x:Key="CoralStrongBrush" Color="#E0644A" />  <!-- Tiến trình trên nút BẮT ĐẦU -->
    <SolidColorBrush x:Key="OnCoralBrush" Color="#111111" />  <!-- Chữ trên nút BẮT ĐẦU -->
    <SolidColorBrush x:Key="OnCoralSubtleBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#047857" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B91C1C" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE2E2" />
    <SolidColorBrush x:Key="GlassBrush" Color="#99FFFFFF" />  <!-- Ô tích trên thẻ -->
    <SolidColorBrush x:Key="TrackBrush" Color="#80FFFFFF" />  <!-- Rãnh thanh tiến trình trên thẻ -->
    <SolidColorBrush x:Key="InkTrackBrush" Color="#33FFFFFF" />  <!-- Rãnh tiến trình trên nền Ink -->
    <SolidColorBrush x:Key="HoverLineBrush" Color="#33111111" />  <!-- Viền khi rê chuột -->
    <SolidColorBrush x:Key="HoverLineStrongBrush" Color="#40111111" />
    <SolidColorBrush x:Key="TagLineBrush" Color="#59111111" />
    <SolidColorBrush x:Key="ShadowColorBrush" Color="#000000" />
</ResourceDictionary>
